# Copy this file to .env and set the values you need. Compose uses the same file
# for variable interpolation and as the container environment.

# Provider credential. You can also store it through the Web UI, which writes
# $DSH_HOME/.credentials.yaml inside the persistent dsh-home volume.
DEEPSEEK_API_KEY=

# Optional provider endpoint overrides.
# DEEPSEEK_BASE_URL=
# DEEPSEEK_SEARCH_BASE_URL=

# URL printed at startup and exposed to the agent as DSH_WEB_URL. It grants no
# access; set it to the URL browsers use. Defaults to
# http://localhost:<DSH_PORT or DSH_WEB_PORT>/.
# DSH_PUBLIC_URL=https://app.example/

# Extra Host/Origin authorities accepted by the browser trust fence, comma
# separated. Add the authority you open when it is not loopback. Prefer stable
# host names over DHCP addresses: a port-less entry matches any port, while an
# unknown authority gets 403 on every API call. Wildcards and CIDR are invalid.
# DSH_TRUSTED_HOSTS=my-host,my-host.local,dsh.example.com

# workspace-write keeps agent commands confined to /workspace. Use
# danger-full-access only when the container itself is the isolation boundary.
# DSH_PERMISSION_MODE=workspace-write

# Container listen port and host-side port mapping.
# DSH_WEB_PORT=3080
# DSH_PORT=3080

# Host interface Docker publishes the port on. Keep 127.0.0.1 for local-only
# access. Use 0.0.0.0 for LAN access or a tunnel that runs on another host;
# pair it with a trusted host name and prefer TLS for public access.
# DSH_BIND_ADDRESS=127.0.0.1

# Set these to bind-mount host directories instead of the named volumes.
# DSH_HOME_VOLUME=./data/dsh-home
# DSH_AGENTS_VOLUME=./data/agents

# Host project directory mounted at /workspace.
# DSH_WORKSPACE_DIR=./workspace

# Directory-picker home. Defaults to /home/dsh, which is not a volume; set
# /workspace to make the mounted workspace the picker home.
# HOME=/workspace
